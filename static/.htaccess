  RewriteRule ^nl/standbouw_bilbao/?$ /nl/standontwerp_montage_bilbao [R=301,L]
  RewriteRule ^nl/standbouw_lissabon/?$ /nl/standontwerp_montage_lissabon [R=301,L]
  RewriteRule ^nl/standbouw_malaga/?$ /nl/standontwerp_montage_malaga [R=301,L]
  RewriteRule ^nl/standbouw_badajoz/?$ /nl/standontwerp_montage_badajoz [R=301,L]
  RewriteRule ^nl/standbouw_sevilla/?$ /nl/standontwerp_montage_sevilla [R=301,L]
  RewriteRule ^nl/standbouw_ciudad_real/?$ /nl/standontwerp_montage_ciudad_real [R=301,L]
  RewriteRule ^nl/standbouw_zaragoza/?$ /nl/standontwerp_montage_zaragoza [R=301,L]


  # /blog (listado) -> blog.html, evitando la colisión 403 con la carpeta /blog/ de artículos
  RewriteCond %{REQUEST_URI} ^/blog/?$
  RewriteRule ^ blog.html [L]

  # /admin es territorio PHP (panel de correos): que use su index.php normal,
  # nunca el .html. Sin esta exclusión, el .html basura que el prerender pueda
  # dejar en admin/ eclipsaría el panel.
  RewriteCond %{REQUEST_URI} !^/admin
  # Servir <ruta>.html cuando exista, AUNQUE exista un directorio homónimo.
  # SvelteKit genera carpetas (proyectos/<id>/, noticias/<slug>/...) que solo
  # contienen __data.json; sin esta regla Apache redirige al directorio vacío
  # de índice y responde 403.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Eliminar barra inclinada al final si no hay .html equivalente ni es un directorio real
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>


