  RewriteRule ^en/stand_construction_ciudad_real/?$ /en/stand_design_assembly_ciudad_real [R=301,L]
  RewriteRule ^en/stand_construction_zaragoza/?$ /en/stand_design_assembly_zaragoza [R=301,L]
  RewriteRule ^de/messestandbau_madrid/?$ /de/messestand_design_montage_madrid [R=301,L]
  RewriteRule ^de/messestandbau_barcelona/?$ /de/messestand_design_montage_barcelona [R=301,L]
