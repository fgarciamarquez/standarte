  # --- Defensa básica contra extractores/clonadores de la web (wget --mirror, HTTrack...) ---
  # No afecta a buscadores (Googlebot/Bingbot) ni a los rastreadores de IA que la web busca
  # captar a propósito (GPTBot, ClaudeBot, PerplexityBot...): solo bloquea firmas de
  # herramientas de descarga/clonado masivo. Excluye los dos endpoints PHP que el cron de
  # GitHub Actions invoca con curl (cron_drip.php, bounce-handler.php) para no romperlos.
  RewriteCond %{REQUEST_URI} !^/admin/email_campaing/cron_drip\.php [NC]
  RewriteCond %{REQUEST_URI} !^/bounce-handler\.php [NC]
  RewriteCond %{HTTP_USER_AGENT} (HTTrack|WebCopier|WebZIP|WebReaper|Teleport|SiteSucker|Offline\ Explorer|WebStripper|larbin|libwww-perl|python-requests|python-urllib|^Scrapy|node-fetch|^Wget|^curl) [NC]
  RewriteRule ^ - [F,L]

  # --- Datos internos del panel de administración: nunca por HTTP ---------------------
  # Los .txt/.json/.log que hay bajo /admin/ son ficheros de trabajo del sistema de
  # campañas (contraseña del buzón, registro de envíos con correos de destinatarios,
  # clics). Se detectó el 2026-08-01 que respondían 200 a cualquiera que conociera la
  # ruta. Hay además un .htaccess propio en email_campaing/data/; esta regla es la red
  # de seguridad para lo que pueda aparecer más adelante en otras carpetas de /admin/.
  # Los PHP los siguen leyendo del sistema de ficheros, así que no se rompe nada.
  RewriteRule ^admin/.*\.(txt|json|log|ini|bak|sql)$ - [F,L]

  # --- Protección anti-hotlink de imágenes: evita que otros dominios embeban directamente
  # las fotos de /img/ (ahorra ancho de banda y dificulta la reutilización directa). Se
  # permite SIEMPRE que no haya Referer (así no se rompe Google Imágenes, RSS, ni los
  # navegadores que lo ocultan por privacidad) y el propio dominio, buscadores y redes
  # sociales que generan vista previa al compartir un enlace.
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?standarte\.es [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?google\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?bing\.com [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?(facebook|fb|twitter|x|linkedin|whatsapp)\.(com|me) [NC]
  RewriteRule \.(jpe?g|png|gif|avif|webp|svg)$ - [F,L,NC]

  # --- Protección anti-hotlink del aplicativo JS/CSS (incluido el mapa de Pat): impide que
  # otros dominios embeban o sirvan directamente los chunks del sitio, de modo que una copia
  # del bundle en otra web no se cargue desde aquí. Mismo criterio SEGURO que las imágenes:
  # se permite SIEMPRE sin Referer (no rompe carga directa, buscadores ni navegadores que lo
  # ocultan por privacidad) y desde el propio dominio, buscadores y redes sociales. Las
  # peticiones del propio sitio son de mismo origen (Referer standarte.es) → nunca se bloquean.
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?standarte\.es [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?google\. [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?bing\.com [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?(facebook|fb|twitter|x|linkedin|whatsapp)\.(com|me) [NC]
  RewriteRule \.(js|css)$ - [F,L,NC]
</IfModule>
