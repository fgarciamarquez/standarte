Options -Indexes -MultiViews
DirectoryIndex index.html index.php
# SvelteKit crea por cada pagina un fichero X.html y una carpeta X/ (con __data.json).
# Sin esto, pedir /X (sin barra) provoca un 301 de Apache para anadir la barra (DirectorySlash),
# y como el sitemap y las canonicas usan la URL sin barra, Google las ve como "pagina con redireccion".
DirectorySlash Off

# Redirecciones 301 con destino ABSOLUTO (https://standarte.es/...): así Apache no añade el
# puerto :443 al Location (que Google marcaba como "HTTPS no evaluado").
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonicalizacion de dominio: una sola version indexable (https y sin www).
  # OVH senaliza HTTPS de forma fiable (HTTPS=on en https, off en http; verificado),
  # por lo que esta regla redirige cada variante a https://standarte.es sin bucles.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://standarte.es%{REQUEST_URI} [R=301,L]

  # --- Legado del sitio PHP anterior (Google aún sondea estas URLs y daban 404) ---
  # No existe página de privacidad propia (el texto legal es un modal del pie) ni index.php: a la home.
  RewriteRule ^index\.php$ https://standarte.es/ [R=301,L]
  RewriteRule ^privacy_policy\.php$ https://standarte.es/ [R=301,L]
  RewriteRule ^cookie_policy\.php$ https://standarte.es/ [R=301,L]

  # Redirigir carpetas de idiomas a sus archivos HTML correspondientes para evitar error 403/500 por no tener index.html
  RewriteCond %{REQUEST_URI} ^/en/?$
  RewriteRule ^ en.html [L]
  RewriteCond %{REQUEST_URI} ^/de/?$
  RewriteRule ^ de.html [L]
  RewriteCond %{REQUEST_URI} ^/zh/?$
  RewriteRule ^ zh.html [L]
  RewriteCond %{REQUEST_URI} ^/hi/?$
  RewriteRule ^ hi.html [L]
  RewriteCond %{REQUEST_URI} ^/pt/?$
  RewriteRule ^ pt.html [L]
  RewriteCond %{REQUEST_URI} ^/fr/?$
  RewriteRule ^ fr.html [L]
  RewriteCond %{REQUEST_URI} ^/it/?$
  RewriteRule ^ it.html [L]
  RewriteCond %{REQUEST_URI} ^/ko/?$
  RewriteRule ^ ko.html [L]
  RewriteCond %{REQUEST_URI} ^/ja/?$
  RewriteRule ^ ja.html [L]

  # --- Migración /noticias -> /blog (301 para conservar el SEO de lo ya indexado) ---
  # Artículos: todos los idiomas vivían bajo /noticias/<slug>
  RewriteRule ^noticias/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  # Artículos con PREFIJO de idioma (URLs antiguas indexadas: /pt/noticias/<slug>,
  # /hi/samachar/<slug>...). Los artículos actuales viven en /blog/<slug> (sin prefijo),
  # así que se redirige el slug. Requieren <slug> tras el segmento, por lo que no chocan
  # con las redirecciones de listado de abajo (^xx/segmento/?$).
  RewriteRule ^en/news/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^de/nachrichten/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^zh/xinwen/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^hi/samachar/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^pt/noticias/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^fr/actualites/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^it/notizie/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  RewriteRule ^ko/sosig/(.+?)/?$ https://standarte.es/blog/$1 [R=301,L]
  # Listado ES y variantes de idioma antiguas -> /blog equivalente
  RewriteRule ^noticias/?$ https://standarte.es/blog [R=301,L]
  RewriteRule ^en/news/?$ https://standarte.es/en/blog [R=301,L]
  RewriteRule ^de/nachrichten/?$ https://standarte.es/de/blog [R=301,L]
  RewriteRule ^zh/xinwen/?$ https://standarte.es/zh/blog [R=301,L]
  RewriteRule ^hi/samachar/?$ https://standarte.es/hi/blog [R=301,L]
  RewriteRule ^pt/noticias/?$ https://standarte.es/pt/blog [R=301,L]
  RewriteRule ^fr/actualites/?$ https://standarte.es/fr/blog [R=301,L]
  RewriteRule ^it/notizie/?$ https://standarte.es/it/blog [R=301,L]
  RewriteRule ^ko/sosig/?$ https://standarte.es/ko/blog [R=301,L]

  # --- Migración construcción -> diseño y montaje (301, slugs de ciudad, 11 idiomas) ---
  RewriteRule ^construccion_stands_madrid/?$ https://standarte.es/diseno_montaje_stands_madrid [R=301,L]
  RewriteRule ^construccion_stands_barcelona/?$ https://standarte.es/diseno_montaje_stands_barcelona [R=301,L]
