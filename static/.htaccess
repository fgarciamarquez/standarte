Options -Indexes -MultiViews
DirectoryIndex index.html index.php
# SvelteKit crea por cada pagina un fichero X.html y una carpeta X/ (con __data.json).
# Sin esto, pedir /X (sin barra) provoca un 301 de Apache para anadir la barra (DirectorySlash),
# y como el sitemap y las canonicas usan la URL sin barra, Google las ve como "pagina con redireccion".
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonicalizacion de dominio: una sola version indexable (https y sin www).
  # OVH senaliza HTTPS de forma fiable (HTTPS=on en https, off en http; verificado),
  # por lo que esta regla redirige cada variante a https://standarte.es sin bucles.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://standarte.es%{REQUEST_URI} [R=301,L]

  # --- Legado del sitio PHP anterior (Google aún sondea estas URLs y daban 404) ---
  # No existe página de privacidad propia (el texto legal es un modal del pie) ni index.php: a la home.
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^privacy_policy\.php$ / [R=301,L]

  # Redirigir carpetas de idiomas a sus archivos HTML correspondientes para evitar error 403/500 por no tener index.html
  RewriteCond %{REQUEST_URI} ^/en/?$
  RewriteRule ^ en.html [L]
  RewriteCond %{REQUEST_URI} ^/de/?$
  RewriteRule ^ de.html [L]
  RewriteCond %{REQUEST_URI} ^/zh/?$
  RewriteRule ^ zh.html [L]
  RewriteCond %{REQUEST_URI} ^/hi/?$
  RewriteRule ^ hi.html [L]
  RewriteCond %{REQUEST_URI} ^/pt/?$
  RewriteRule ^ pt.html [L]
  RewriteCond %{REQUEST_URI} ^/fr/?$
  RewriteRule ^ fr.html [L]
  RewriteCond %{REQUEST_URI} ^/it/?$
  RewriteRule ^ it.html [L]
  RewriteCond %{REQUEST_URI} ^/ko/?$
  RewriteRule ^ ko.html [L]
  RewriteCond %{REQUEST_URI} ^/ja/?$
  RewriteRule ^ ja.html [L]

  # --- Migración /noticias -> /blog (301 para conservar el SEO de lo ya indexado) ---
  # Artículos: todos los idiomas vivían bajo /noticias/<slug>
  RewriteRule ^noticias/(.+?)/?$ /blog/$1 [R=301,L]
  # Listado ES y variantes de idioma antiguas -> /blog equivalente
  RewriteRule ^noticias/?$ /blog [R=301,L]
  RewriteRule ^en/news/?$ /en/blog [R=301,L]
  RewriteRule ^de/nachrichten/?$ /de/blog [R=301,L]
  RewriteRule ^zh/xinwen/?$ /zh/blog [R=301,L]
  RewriteRule ^hi/samachar/?$ /hi/blog [R=301,L]
  RewriteRule ^pt/noticias/?$ /pt/blog [R=301,L]
  RewriteRule ^fr/actualites/?$ /fr/blog [R=301,L]
  RewriteRule ^it/notizie/?$ /it/blog [R=301,L]
  RewriteRule ^ko/sosig/?$ /ko/blog [R=301,L]

  # --- Migración construcción -> diseño y montaje (301, slugs de ciudad, 11 idiomas) ---
  RewriteRule ^construccion_stands_madrid/?$ /diseno_montaje_stands_madrid [R=301,L]
  RewriteRule ^construccion_stands_barcelona/?$ /diseno_montaje_stands_barcelona [R=301,L]
  RewriteRule ^construccion_stands_bilbao/?$ /diseno_montaje_stands_bilbao [R=301,L]
  RewriteRule ^construccion_stands_lisboa/?$ /diseno_montaje_stands_lisboa [R=301,L]
  RewriteRule ^construccion_stands_malaga/?$ /diseno_montaje_stands_malaga [R=301,L]
  RewriteRule ^construccion_stands_badajoz/?$ /diseno_montaje_stands_badajoz [R=301,L]
  RewriteRule ^construccion_stands_sevilla/?$ /diseno_montaje_stands_sevilla [R=301,L]
  RewriteRule ^construccion_stands_ciudad_real/?$ /diseno_montaje_stands_ciudad_real [R=301,L]
  RewriteRule ^construccion_stands_zaragoza/?$ /diseno_montaje_stands_zaragoza [R=301,L]
  RewriteRule ^en/stand_construction_madrid/?$ /en/stand_design_assembly_madrid [R=301,L]
  RewriteRule ^en/stand_construction_barcelona/?$ /en/stand_design_assembly_barcelona [R=301,L]
  RewriteRule ^en/stand_construction_bilbao/?$ /en/stand_design_assembly_bilbao [R=301,L]
  RewriteRule ^en/stand_construction_lisbon/?$ /en/stand_design_assembly_lisbon [R=301,L]
  RewriteRule ^en/stand_construction_malaga/?$ /en/stand_design_assembly_malaga [R=301,L]
  RewriteRule ^en/stand_construction_badajoz/?$ /en/stand_design_assembly_badajoz [R=301,L]
