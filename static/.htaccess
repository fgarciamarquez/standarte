  # /blog (listado) -> blog.html, evitando la colisión 403 con la carpeta /blog/ de artículos
  RewriteCond %{REQUEST_URI} ^/blog/?$
  RewriteRule ^ blog.html [L]

  # --- Barra final -> canónica sin barra (301) ---
  # DEBE ir ANTES del enrutado a .html de abajo: esa regla (^(.+?)/?$ -> $1.html [L]) sirve
  # <ruta>.html también para la variante CON barra, dejándola en 200. Google encontró esas
  # variantes con barra (legado) y las marcaba como "Página alternativa con etiqueta canónica
  # adecuada" (excluidas). Este 301 las consolida en su canónica sin barra. Exclusiones:
  #  - Homes de idioma (/xx/): su canónica lleva barra (ya resueltas arriba; se excluyen por seguridad).
  #  - /proyectos/: los slugs viejos tienen Redirect 301 propio (evita saltos dobles); los actuales quedan igual.
  #  - /admin: territorio PHP (panel de correos); sirve su index.php de directorio, no debe perder la barra.
  #  - /X/__data.json no termina en barra: la navegación SvelteKit no se ve afectada.
  RewriteCond %{REQUEST_URI} !^/[a-z]{2}/$
  RewriteCond %{REQUEST_URI} !^/proyectos/
  RewriteCond %{REQUEST_URI} !^/admin
  RewriteRule ^(.+)/$ https://standarte.es/$1 [R=301,L]

  # /admin es territorio PHP (panel de correos): que use su index.php normal,
  # nunca el .html. Sin esta exclusión, el .html basura que el prerender pueda
  # dejar en admin/ eclipsaría el panel.
  RewriteCond %{REQUEST_URI} !^/admin
  # Servir <ruta>.html cuando exista, AUNQUE exista un directorio homónimo.
  # SvelteKit genera carpetas (proyectos/<id>/, noticias/<slug>/...) que solo
  # contienen __data.json; sin esta regla Apache redirige al directorio vacío
  # de índice y responde 403.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Eliminar barra inclinada al final si no hay .html equivalente ni es un directorio real
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ https://standarte.es/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  # Las fuentes se sirven desde aquí desde que dejamos de usar Google Fonts. Sin este
  # AddType el servidor no resuelve su tipo: no mandaba Content-Type (mal, porque
  # enviamos X-Content-Type-Options: nosniff) y tampoco se aplicaba el ExpiresByType
  # font/woff2 de más abajo, así que se redescargaban en cada visita.
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>


