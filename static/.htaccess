  RewriteCond %{QUERY_STRING} (^|&)lang=ja(&|$)
  RewriteRule ^proyectos/stand_para_fabricacion_pavimentos_madrid/?$ https://standarte.es/ja/%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/%E5%BA%8A%E6%9D%90%E8%A3%BD%E9%80%A0-%E3%83%9E%E3%83%89%E3%83%AA%E3%83%BC%E3%83%89? [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)lang=ja(&|$)
  RewriteRule ^proyectos/stand_para_gestion_trafico_inteligente_lisboa/?$ https://standarte.es/ja/%E3%83%97%E3%83%AD%E3%82%B8%E3%82%A7%E3%82%AF%E3%83%88/%E3%82%B9%E3%83%9E%E3%83%BC%E3%83%88%E4%BA%A4%E9%80%9A%E7%AE%A1%E7%90%86-%E3%83%AA%E3%82%B9%E3%83%9C%E3%83%B3? [R=301,L,NE]

  # /blog (listado) -> blog.html, evitando la colisión 403 con la carpeta /blog/ de artículos
  RewriteCond %{REQUEST_URI} ^/blog/?$
  RewriteRule ^ blog.html [L]

  # /admin es territorio PHP (panel de correos): que use su index.php normal,
  # nunca el .html. Sin esta exclusión, el .html basura que el prerender pueda
  # dejar en admin/ eclipsaría el panel.
  RewriteCond %{REQUEST_URI} !^/admin
  # Servir <ruta>.html cuando exista, AUNQUE exista un directorio homónimo.
  # SvelteKit genera carpetas (proyectos/<id>/, noticias/<slug>/...) que solo
  # contienen __data.json; sin esta regla Apache redirige al directorio vacío
  # de índice y responde 403.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Eliminar barra inclinada al final si no hay .html equivalente ni es un directorio real
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ https://standarte.es/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>


